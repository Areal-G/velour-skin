# -----------------------------------------------------------------------------
# Velour Skin — environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# Every integration is optional: without keys the storefront runs on the
# built-in 50,000-product sample catalog, customer accounts use the built-in
# auth provider, and checkout shows a clear "not enabled" notice instead of
# pretending to take payment.
# -----------------------------------------------------------------------------

# Public base URL, used for canonical URLs, sitemaps and Stripe redirects.
# On Vercel this falls back to the production / preview URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Authentication ------------------------------------------------------------
# Without Supabase, a built-in provider stores accounts in .data/users.json and
# signs session cookies with this secret (auto-generated locally if unset).
# Set a long random value in any shared/production environment:
#   openssl rand -base64 48
AUTH_SECRET=
# Directory for the built-in provider's user store and generated secret.
# Defaults to ./.data (or /tmp/velour-skin on Vercel).
AUTH_DATA_DIR=

# --- Supabase (auth + database) ----------------------------------------------
# Project Settings → API. The publishable (anon) key is safe for the browser;
# Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name for the publishable key, read only when the line above is removed.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (service role) key — used for order writes from the
# checkout, verified webhooks and `npm run seed`. NEVER expose this to the browser.
SUPABASE_SECRET_KEY=
# Legacy name for the secret key, read only when the line above is removed.
# SUPABASE_SERVICE_ROLE_KEY=

# Serve products from Supabase instead of the in-memory sample catalog.
# Run `npm run seed` first. Values: "memory" (default) | "supabase"
CATALOG_SOURCE=memory

# --- Sample data (`npm run seed`) ---------------------------------------------
# Sign-in for the sample customer the seed creates with six past orders.
# Required for a hosted project; against a local Supabase they default to
# customer@example.com / velour-skin-local.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# --- Stripe (payments) -------------------------------------------------------
# Use test-mode keys (sk_test_…) for development. Dashboard → Developers.
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/payment (whsec_…). For local development:
#   stripe listen --forward-to localhost:3000/api/webhooks/payment
STRIPE_WEBHOOK_SECRET=

# --- On-demand revalidation --------------------------------------------------
# Shared secret for POST /api/revalidate (generate with `openssl rand -hex 32`).
REVALIDATE_SECRET=

# --- Set by the platform or tooling (do not set by hand) ----------------------
# NODE_ENV                                     production builds mark cookies Secure
# VERCEL, VERCEL_ENV, VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL                Vercel deployment metadata
# CI                                           stricter Playwright settings in CI

# --- End-to-end tests (`npm run test:e2e`) -------------------------------------
# PORT=3000                                    port of the server Playwright starts
# PLAYWRIGHT_BASE_URL=http://localhost:3000    test an already running server instead
# E2E_STRIPE_ENABLED=1                         include the Stripe redirect tests
