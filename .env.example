# -----------------------------------------------------------------------------
# Velour Skin — portfolio demo
# This branch needs no environment variables: products, the demo account and
# its orders live in memory, and there is no database or external service.
# Copy to `.env.local` only to override the values below.
# -----------------------------------------------------------------------------

# Public base URL, used for canonical URLs and sitemaps. netlify.toml sets the
# live demo's URL; locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate (generate with `openssl rand -hex 32`).
# Optional: without it the endpoint is disabled.
REVALIDATE_SECRET=

# --- Leave unset in the demo --------------------------------------------------
# Stripe keys only matter on `main`. Checkout stays off in the demo either way,
# because there is no database to record orders in.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Set by the platform or tooling (do not set by hand) ----------------------
# NODE_ENV                                     production builds mark cookies Secure
# VERCEL_ENV, VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL                Vercel deployment metadata
# CI                                           stricter Playwright settings in CI

# --- End-to-end tests (`npm run test:e2e`) -------------------------------------
# PORT=3000                                    port of the server Playwright starts
# PLAYWRIGHT_BASE_URL=http://localhost:3000    test an already running server instead
# E2E_STRIPE_ENABLED=1                         include the Stripe redirect tests
